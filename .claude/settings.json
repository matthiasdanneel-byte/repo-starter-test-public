{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "git",
        "url": "https://github.com/anthropics/claude-plugins-official.git"
      }
    }
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "d=\"${CLAUDE_PROJECT_DIR:-.}\"; [ -f \"$d/.claude/hooks/repo-starter.sh\" ] || exit 0; exec bash \"$d/.claude/hooks/repo-starter.sh\" git-freshness",
            "shell": "bash",
            "timeout": 30,
            "statusMessage": "Checking how far behind the remote this checkout is...",
            "onFailure": "continue"
          }
        ]
      },
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "d=\"${CLAUDE_PROJECT_DIR:-.}\"; [ -f \"$d/.claude/hooks/repo-starter.sh\" ] || exit 0; exec bash \"$d/.claude/hooks/repo-starter.sh\" superpowers-check",
            "shell": "bash",
            "timeout": 10,
            "onFailure": "continue"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "d=\"${CLAUDE_PROJECT_DIR:-.}\"; [ -f \"$d/.claude/hooks/repo-starter.sh\" ] || exit 0; exec bash \"$d/.claude/hooks/repo-starter.sh\" secret-warning",
            "shell": "bash",
            "timeout": 20,
            "if": "Bash(git commit *)",
            "onFailure": "continue"
          },
          {
            "type": "command",
            "command": "d=\"${CLAUDE_PROJECT_DIR:-.}\"; [ -f \"$d/.claude/hooks/repo-starter.sh\" ] || exit 0; exec bash \"$d/.claude/hooks/repo-starter.sh\" secret-warning",
            "shell": "bash",
            "timeout": 20,
            "if": "Bash(git push *)",
            "onFailure": "continue"
          },
          {
            "type": "command",
            "command": "d=\"${CLAUDE_PROJECT_DIR:-.}\"; [ -f \"$d/.claude/hooks/repo-starter.sh\" ] || exit 0; exec bash \"$d/.claude/hooks/repo-starter.sh\" secret-warning",
            "shell": "bash",
            "timeout": 20,
            "if": "PowerShell(git commit *)",
            "onFailure": "continue"
          },
          {
            "type": "command",
            "command": "d=\"${CLAUDE_PROJECT_DIR:-.}\"; [ -f \"$d/.claude/hooks/repo-starter.sh\" ] || exit 0; exec bash \"$d/.claude/hooks/repo-starter.sh\" secret-warning",
            "shell": "bash",
            "timeout": 20,
            "if": "PowerShell(git push *)",
            "onFailure": "continue"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr checks*)",
      "Bash(gh pr diff*)",
      "Bash(gh pr create*)",
      "Bash(gh issue view*)",
      "Bash(gh issue list*)",
      "Bash(gh run view*)",
      "Bash(gh run list*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git fetch*)",
      "Bash(git switch*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git push*)",
      "PowerShell(gh pr view*)",
      "PowerShell(gh pr list*)",
      "PowerShell(gh pr checks*)",
      "PowerShell(gh pr diff*)",
      "PowerShell(gh pr create*)",
      "PowerShell(gh issue view*)",
      "PowerShell(gh issue list*)",
      "PowerShell(gh run view*)",
      "PowerShell(gh run list*)",
      "PowerShell(git status*)",
      "PowerShell(git diff*)",
      "PowerShell(git log*)",
      "PowerShell(git fetch*)",
      "PowerShell(git switch*)",
      "PowerShell(git add*)",
      "PowerShell(git commit*)",
      "PowerShell(git push*)",
      "Bash(uv run ruff *)",
      "PowerShell(uv run ruff *)",
      "Bash(uv run pytest*)",
      "PowerShell(uv run pytest*)",
      "Bash(uv sync*)",
      "PowerShell(uv sync*)"
    ],
    "ask": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push * +*)",
      "Bash(git push * main)",
      "Bash(git push *:main)",
      "Bash(git push *:refs/heads/main*)",
      "Bash(gh api -X*)",
      "Bash(gh api * -X*)",
      "Bash(gh api --method*)",
      "Bash(gh api * --method*)",
      "Bash(gh api * -f *)",
      "Bash(gh api * -F *)",
      "Bash(gh api * --field *)",
      "Bash(gh api * --raw-field *)",
      "Bash(gh api * --input *)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git push * --force*)",
      "PowerShell(git push * -f)",
      "PowerShell(git push * -f *)",
      "PowerShell(git push * +*)",
      "PowerShell(git push * main)",
      "PowerShell(git push *:main)",
      "PowerShell(git push *:refs/heads/main*)",
      "PowerShell(gh api -X*)",
      "PowerShell(gh api * -X*)",
      "PowerShell(gh api --method*)",
      "PowerShell(gh api * --method*)",
      "PowerShell(gh api * -f *)",
      "PowerShell(gh api * -F *)",
      "PowerShell(gh api * --field *)",
      "PowerShell(gh api * --raw-field *)",
      "PowerShell(gh api * --input *)"
    ],
    "deny": [
      "Bash(gh pr merge*)",
      "PowerShell(gh pr merge*)"
    ]
  }
}
